<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_shopify_branch_inherit" model="ir.ui.view">
        <field name="name">account.move.form.shopify.branch.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='partner_id']" position="after">

                <field name="is_shopify_invoice"
                       invisible="1"/>

                <field name="shopify_branch_id"
                       readonly="1"
                       options="{'no_create': True, 'no_open': True}"
                       invisible="not is_shopify_invoice"/>

                <field name="shopify_order_ref"
                       readonly="1"
                       invisible="not is_shopify_invoice"/>

                <field name="shopify_store_ref"
                       readonly="1"
                       invisible="not is_shopify_invoice"/>

            </xpath>

        </field>
    </record>

</odoo>